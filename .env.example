# URL do servidor API
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Para desenvolvimento local (mudar IP do seu servidor)
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000/api

# Configurações de background (minutos)
BACKGROUND_SYNC_INTERVAL=5
HEARTBEAT_INTERVAL=30

# Limite de cache (em MB)
CACHE_LIMIT_MB=2048

# Debug mode
DEBUG_MODE=false
